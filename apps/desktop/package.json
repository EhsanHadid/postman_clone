{
  "name": "@postman-clone/desktop",
  "version": "1.0.2",
  "description": "Postman Clone desktop API client",
  "author": "Postman Clone",
  "homepage": "https://github.com/EhsanHadid/postman_clone",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "build": "tsc -p tsconfig.json",
    "copy-renderer": "node scripts/copy-renderer.mjs",
    "generate-assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "package": "corepack yarn build && corepack yarn copy-renderer && node scripts/package.mjs"
  },
  "dependencies": {
    "@postman-clone/shared-types": "1.0.2",
    "@postman-clone/shared-utils": "1.0.2"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "com.postmanclone.desktop",
    "productName": "Postman Clone",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/icon.ico",
    "directories": {
      "buildResources": "assets",
      "output": "release-desktop"
    },
    "win": {
      "executableName": "Postman Clone",
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "executableName": "postman-clone",
      "icon": "assets/icon-linux.png",
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "Postman Clone <support@postman.mahac.af>",
      "synopsis": "Postman Clone desktop API client",
      "description": "Desktop API client for executing localhost and private-network requests."
    },
    "deb": {
      "artifactName": "postman-clone-${version}-${arch}.${ext}",
      "packageName": "postman-clone"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Postman Clone"
    }
  }
}
