{
  "name": "@postman-clone/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\" && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "db:migrate:compiled": "node dist/database/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.17",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.17",
    "@nestjs/platform-express": "^11.0.17",
    "@nestjs/typeorm": "^11.0.0",
    "@postman-clone/shared-types": "0.1.0",
    "@postman-clone/shared-utils": "0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.0.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
